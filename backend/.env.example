# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+asyncpg://smart:smart_dev_pw@127.0.0.1:5432/smart_messenger
REDIS_URL=redis://127.0.0.1:6379/0
# 32 random bytes, base64. Generate with:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Losing this key makes every stored message unreadable.
MASTER_KEY=
# true when served over HTTPS
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
# Meta Model API key for AI assist. If omitted, API_KEY from the repo-root .env is used.
# META_API_KEY=
# LLM_MODEL=muse-spark-1.3
# LLM_REASONING_EFFORT=minimal
